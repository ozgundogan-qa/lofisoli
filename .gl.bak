@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 139 13% 97%;
    --foreground: 140 36% 10%;
    --card: 0 0% 100%;
    --card-foreground: 140 36% 10%;
    --popover: 0 0% 100%;
    --popover-foreground: 140 36% 10%;
    --primary: 140 85% 50%;
    --primary-foreground: 140 36% 10%;
    --muted: 142 32% 90%;
    --muted-foreground: 142 32% 40%;
    --border: 142 32% 90%;
    --input: 142 32% 90%;
    --ring: 140 85% 50%;
    --radius: 0.5rem;
  }

  .dark {
    --background: 140 36% 10%; /* #102216 */
    --foreground: 0 0% 100%;
    --card: 142 32% 15%; /* #1a3323 */
    --card-foreground: 0 0% 100%;
    --popover: 142 32% 15%;
    --popover-foreground: 0 0% 100%;
    --primary: 140 85% 50%; /* #13ec5b */
    --primary-foreground: 140 36% 10%;
    --muted: 140 34% 21%; /* #23482f */
    --muted-foreground: 139 13% 70%;
    --border: 140 34% 21%;
    --input: 140 34% 21%;
    --ring: 140 85% 50%;
  }
}

@layer base {
  body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
    font-feature-settings: "rlig" 1, "calt" 1;
  }
  
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-serif);
    letter-spacing: -0.025em;
  }
}

::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: hsl(var(--background)); 
}
::-webkit-scrollbar-thumb {
  background: hsl(var(--primary)); 
  border-radius: 4px;
}
